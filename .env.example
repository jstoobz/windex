# ============================================================================
# .env.example — Windex Configuration
# ============================================================================
# Copy to .env and fill in values. All scripts read from environment first,
# falling back to defaults below. .env is gitignored — never commit secrets.
# ============================================================================

# === Required (no defaults — must be set per deployment) ===
TAILSCALE_AUTHKEY=            # One-time key from https://login.tailscale.com/admin/settings/keys

# === User account ===
STANDARD_USERNAME=            # Standard (non-admin) account name (prompted if empty)
STANDARD_PASSWORD=            # Prompted if empty. Cannot contain: ! % & | ^ < > "
ADMIN_SSH_PUBKEY=             # SSH public key for remote access (optional)

# === Network ===
TAILSCALE_SUBNET=100.64.0.0/10
VNC_PORT=5900
SSH_PORT=22
DNS_PRIMARY=1.1.1.3           # Cloudflare Family (malware + phishing blocking)
DNS_SECONDARY=1.0.0.3

# === Download URLs ===
TAILSCALE_URL=https://pkgs.tailscale.com/stable/tailscale-setup-latest.exe
# VNC installed via winget (TigerVNC.TigerVNC) — no download URL needed
CHROME_MSI_URL=https://dl.google.com/dl/chrome/install/googlechromestandaloneenterprise_arm64.msi

# === Paths (Windows guest) ===
BASE_DIR=C:\provision
TAILSCALE_DIR=C:\Program Files\Tailscale
VNC_DIR=C:\Program Files\TigerVNC

# === Firewall rule names ===
FW_RULE_VNC_ALLOW=VNC-Tailscale-Allow
FW_RULE_VNC_BLOCK=VNC-Block-All
FW_RULE_SSH_ALLOW=SSH-Tailscale-Allow
FW_RULE_SSH_BLOCK=SSH-Block-All

# === VNC (TigerVNC) ===
VNC_PASSWORD_LENGTH=16
VNC_SERVICE=winvnc4

# === Connectivity ===
CONNECTIVITY_CHECK_IP=8.8.8.8

# === Runtime flags (usually set via CLI args, not .env) ===
# DRY_RUN=0
# VERBOSE=0
# FORCE=0
# CONTINUE_ON_ERROR=0
